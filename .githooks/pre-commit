#!/bin/sh
# Pre-commit checks (see scripts/repo_guard.py).
# Enable once per clone:  git config core.hooksPath .githooks
cd "$(git rev-parse --show-toplevel)" || exit 1
if [ -x .venv/bin/python ]; then exec .venv/bin/python scripts/repo_guard.py
else exec uv run --quiet python scripts/repo_guard.py; fi
